# Salin ke .env lalu isi nilainya.
# Prisma membaca .env relatif terhadap prisma/schema.prisma, jadi file ini ada di pmbok-pm/.env.

# SQLite lokal (default demo). Path relatif terhadap folder prisma/.
DATABASE_URL="file:./dev.db"

# Wajib diganti sebelum dipakai bersama orang lain.
# Buat dengan: openssl rand -hex 32
# atau: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="ganti-dengan-32-byte-hex-acak"

# Contoh untuk PostgreSQL (ubah juga provider di prisma/schema.prisma)
# DATABASE_URL="postgresql://user:password@localhost:5432/pmbok?schema=public"
